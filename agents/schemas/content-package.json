{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Content Package",
  "type": "object",
  "required": ["agent", "version", "timestamp", "inputs", "tasks", "outputs", "handoff", "blockers"],
  "properties": {
    "agent": { "const": "04-content" },
    "version": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "inputs": { "type": "object" },
    "tasks": { "type": "array" },
    "outputs": {
      "type": "object",
      "required": ["copy", "seo_keywords"],
      "properties": {
        "copy": { "type": "object" },
        "seo_keywords": { "type": "array" }
      }
    },
    "handoff": { "type": "object" },
    "blockers": { "type": "array" }
  }
}
